<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))</RepositoryRoot>
    <GeneratedSourceDirectory Condition="'$(GeneratedSourceDirectory)' == ''">$(RepositoryRoot)generated\conformance\src</GeneratedSourceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(GeneratedSourceDirectory)\*.csproj" />
  </ItemGroup>
</Project>
